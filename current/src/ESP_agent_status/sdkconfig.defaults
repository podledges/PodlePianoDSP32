# Console choice matches the board's USB Serial/JTAG port. It is not a pin-map claim.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# Conservative build settings. Confirm the physical unit before selecting larger flash/PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
